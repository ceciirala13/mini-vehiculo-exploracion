# MCU_CONTROL (ESP32-S3) defaults
CONFIG_IDF_TARGET="esp32s3"

# 1 ms tick so 20 ms control periods and 10 ms UART reads are exact
CONFIG_FREERTOS_HZ=1000

# Task watchdog (motion task subscribes to it)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=3
CONFIG_ESP_TASK_WDT_PANIC=y

# GPIO43/44 (UART0) carry the link to MCU_COMM: console goes to native USB only
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
